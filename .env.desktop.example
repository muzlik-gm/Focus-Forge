# Desktop App Environment Variables
# Copy this file to .env.desktop.local and fill in your values

# API Server URL - where the desktop app connects for authentication and data
# Development: http://localhost:3000
# Production: https://your-production-server.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# Same as web app - these are used by the Next.js server
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/focusforge?retryWrites=true&w=majority"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (optional for desktop)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
